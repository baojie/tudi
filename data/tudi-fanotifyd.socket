[Unit]
Description=tudi fanotify helper socket
Documentation=https://github.com/baojie/tudi/blob/main/docs/design/fanotify.md

[Socket]
ListenStream=/run/tudi/fanotify.sock
# Anyone may connect; the helper decides per client (SO_PEERCRED) what it
# may hear about.
SocketMode=0666
DirectoryMode=0755

[Install]
WantedBy=sockets.target
